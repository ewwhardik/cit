# ---- web (Next.js) -----------------------------------------------------
# Postgres connection string (Neon in production; local docker/postgres in dev)
DATABASE_URL=postgres://cit:cit@localhost:5432/cit
# Random 32+ char secret for session signing
BETTER_AUTH_SECRET=
# Public base URL of the web app
BETTER_AUTH_URL=http://localhost:3000
# Where the scheduling engine runs
ENGINE_URL=http://localhost:8000
# Shared secret sent as X-Engine-Secret (must match the engine's value); empty = no check
ENGINE_SHARED_SECRET=
# Password for the four seeded demo accounts
DEMO_PASSWORD=crunchweek
# Optional override for the bundled dataset used by seed / "Reset demo data"
DEMO_DATASET_PATH=

# ---- AI layer: Groq only (optional; the manual booking form works without it) ----
GROQ_API_KEY=
GROQ_PARSE_MODEL=openai/gpt-oss-20b
GROQ_ASSIST_MODEL=openai/gpt-oss-120b
AI_TIMEOUT_MS=6000
# "Today" used to resolve words like kal / tomorrow during the demo (Spectra week)
DEMO_TODAY=2027-02-08

# ---- engine (FastAPI) ---------------------------------------------------
ENGINE_SOLVER_WORKERS=8
ENGINE_JOB_WORKERS=2
ENGINE_CORS_ORIGINS=*
ENGINE_DEFAULT_DATASET=
