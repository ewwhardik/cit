# ---- web (Next.js) -----------------------------------------------------
# Postgres connection string (Neon in production; local docker/postgres in dev)
DATABASE_URL=postgres://cit:cit@localhost:5432/cit
# Random 32+ char secret for session signing
BETTER_AUTH_SECRET=
# Public base URL of the web app
BETTER_AUTH_URL=http://localhost:3000
# Where the scheduling engine runs
ENGINE_URL=http://localhost:8000
# Shared secret sent as X-Engine-Secret (must match the engine's value); empty = no check.
# Also authenticates the GitHub Actions solver relay (/api/relay/:id).
ENGINE_SHARED_SECRET=
# Solver relay: long jobs run on GitHub Actions (.github/workflows/engine-relay.yml).
# Leave empty to run every job on ENGINE_URL. Token: fine-grained, Actions read+write on this repo only.
GITHUB_RELAY_TOKEN=
GITHUB_RELAY_REPO=
GITHUB_RELAY_WORKFLOW=engine-relay.yml
GITHUB_RELAY_REF=main
# Password for the four seeded demo accounts
DEMO_PASSWORD=crunchweek
# Optional override for the bundled dataset used by seed / "Reset demo data"
DEMO_DATASET_PATH=

# ---- AI layer (optional: the manual booking form works without it) ------
# Provider: "groq" or "anthropic". If unset, Anthropic is used when its key is set, else Groq.
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_PARSE_MODEL=openai/gpt-oss-20b
GROQ_ASSIST_MODEL=openai/gpt-oss-120b
ANTHROPIC_API_KEY=
AI_PARSE_MODEL=claude-haiku-5-5
AI_ASSIST_MODEL=claude-sonnet-5-5
AI_TIMEOUT_MS=6000
# Iru, the in-app navigator: model override (default: the parse model) and per-user LLM calls per minute
NAVIGATOR_MODEL=
NAVIGATOR_RATE_PER_MIN=12
# "Today" used to resolve words like kal / tomorrow during the demo (Spectra week)
DEMO_TODAY=2027-02-08

# ---- engine (FastAPI) ---------------------------------------------------
ENGINE_SOLVER_WORKERS=8
ENGINE_JOB_WORKERS=2
ENGINE_CORS_ORIGINS=*
ENGINE_DEFAULT_DATASET=
